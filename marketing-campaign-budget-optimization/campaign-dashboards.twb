      <column caption='ROAS Status' datatype='string' name='[Calculation_0201472181215233]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2656336240361476] &gt;= 1 THEN &quot;At/Above Break-even&quot;&#10;ELSE &quot;Below Break-even&quot;&#10;END' />
      </column>
      <column caption='Overall CTR' datatype='real' name='[Calculation_2656336231374848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Clicks]) / SUM([Impressions])' />
      </column>
      <column caption='Overall Conversion Rate' datatype='real' name='[Calculation_2656336232206337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Conversions]) / SUM([Clicks])' />
      </column>
      <column caption='Overall CPC' datatype='real' name='[Calculation_2656336232509442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Cost]) / SUM([Clicks])' />
      </column>
      <column caption='Overall CPA' datatype='real' name='[Calculation_2656336232656899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Cost]) / SUM([Conversions])' />
      </column>
      <column caption='Overall ROAS' datatype='real' name='[Calculation_2656336240361476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) / SUM([Cost])' />
      </column>
      <column caption='Overall ROI' datatype='real' name='[Calculation_2656336240496645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculated P&amp;L]) / SUM([Cost])' />
      </column>
      <column caption='Month Order' datatype='integer' name='[Calculation_2656336240734214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Month]&#10;WHEN &quot;July&quot; THEN 1&#10;WHEN &quot;August&quot; THEN 2&#10;WHEN &quot;September&quot; THEN 3&#10;WHEN &quot;October&quot; THEN 4&#10;WHEN &quot;November&quot; THEN 5&#10;END' />
